{
  "name": "@humanlayer/effect-durable-streams-client",
  "version": "0.1.0-rc.1",
  "description": "Effect-native Durable Streams client with typed streams, schemas, and scoped idempotent producers.",
  "homepage": "https://github.com/humanlayer/effect-durable-streams-client#readme",
  "bugs": {
    "url": "https://github.com/humanlayer/effect-durable-streams-client/issues"
  },
  "license": "MIT",
  "author": "HumanLayer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/humanlayer/effect-durable-streams-client.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "rc"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:integration": "vp test tests/integration",
    "test:package": "vp test tests/package.test.ts",
    "release:tag-info": "bash scripts/release-tag-info.sh",
    "test:conformance": "vp exec client-conformance-tests --run ./tests/conformance/run-adapter.sh",
    "check": "vp check && bun run typed",
    "typed": "node --import tsx tools/typed-lint/src/cli.ts check --config typed-lint.config.json",
    "diff:check": "node --import tsx tools/diff-check/src/main.ts --config tools/diff-check/diff-check.config.json",
    "prepublishOnly": "vp run build",
    "prepare": "effect-tsgo patch --oxlint"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@durable-streams/client-conformance-tests": "0.2.12",
    "@durable-streams/server": "0.3.8",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/tsgo": "^0.38.0",
    "@effect/vitest": "4.0.0-rc.112",
    "@oxlint/plugins": "^1.80.0",
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "fast-glob": "^3.3.3",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript-compiler": "npm:typescript@5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "^0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "ignore"
    }
  }
}
